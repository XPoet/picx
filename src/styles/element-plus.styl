:root
:root.light
:root.dark {
  --el-bg-color var(--picx-color-surface)
  --el-bg-color-page var(--picx-color-bg)
  --el-bg-color-overlay var(--picx-color-surface)
  --el-fill-color var(--picx-color-surface-muted)
  --el-fill-color-light var(--picx-color-bg)
  --el-fill-color-lighter var(--picx-color-bg)
  --el-fill-color-extra-light var(--picx-color-bg)
  --el-fill-color-blank var(--picx-color-surface)
  --el-text-color-primary var(--picx-color-text)
  --el-text-color-regular var(--picx-color-text)
  --el-text-color-secondary var(--picx-color-text-muted)
  --el-text-color-placeholder var(--picx-color-text-muted)
  --el-text-color-disabled var(--picx-color-text-muted)
  --el-border-color var(--picx-color-control-border)
  --el-border-color-light var(--picx-color-border)
  --el-border-color-lighter var(--picx-color-border)
  --el-border-radius-base var(--picx-radius-control)
  --el-border-radius-small var(--picx-radius-control)
  --el-font-size-base var(--picx-font-body)
  --el-font-size-small var(--picx-font-body)
  --el-component-size var(--picx-control-height)
  --el-component-size-small var(--picx-control-height)
  --el-component-size-large var(--picx-control-height)
  --el-disabled-bg-color var(--picx-color-surface-muted)
  --el-disabled-text-color var(--picx-color-text-muted)
  --el-disabled-border-color var(--picx-color-border)
  --el-mask-color var(--picx-color-overlay)
  --el-overlay-color-lighter var(--picx-color-overlay)
  --el-box-shadow-light 0 8px 24px var(--picx-color-shadow)
}

.el-button {
  min-width var(--picx-control-height)
  min-height var(--picx-control-height)
}

.el-button--primary:not(.is-plain, .is-text, .is-link) {
  --el-button-text-color var(--picx-color-on-primary)
  --el-button-hover-text-color var(--picx-color-on-primary)
  --el-button-hover-bg-color var(--picx-color-primary-hover)
  --el-button-hover-border-color var(--picx-color-primary-hover)
  --el-button-active-bg-color var(--picx-color-primary-hover)
  --el-button-active-border-color var(--picx-color-primary-hover)
  --el-button-disabled-text-color var(--picx-color-text-muted)
  --el-button-disabled-bg-color var(--picx-color-surface-muted)
  --el-button-disabled-border-color var(--picx-color-border)
}

.el-button.el-button--primary.is-plain {
  --el-button-text-color var(--picx-color-primary)
  --el-button-bg-color var(--picx-color-primary-soft)
  --el-button-border-color var(--picx-color-primary)
  --el-button-hover-text-color var(--picx-color-on-primary)
  --el-button-hover-bg-color var(--picx-color-primary-hover)
  --el-button-hover-border-color var(--picx-color-primary-hover)
}

.el-input__wrapper
.el-select__wrapper {
  min-height var(--picx-control-height)
}

.el-input__inner
.el-textarea__inner {
  font-size var(--picx-font-body)
}

.el-dialog
.el-message-box {
  --el-dialog-border-radius var(--picx-radius-dialog)
  --el-messagebox-border-radius var(--picx-radius-dialog)
}

.el-message__icon {
  width 16px
  height 16px

  svg {
    width 16px
    height 16px
  }
}

@media (max-width $picx-mobile-breakpoint) {
  .el-input__inner
  .el-textarea__inner
  .el-select__input {
    font-size var(--picx-font-input-mobile)
  }
}
