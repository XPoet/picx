.compress-config-box {
  position relative
  box-sizing border-box


  .img-encoder-title {
    font-size var(--picx-font-body)
  }

  .img-encoder-group {
    display flex
    flex-direction column
    min-width 0
    width 100%
    margin-top 16rem

    .el-radio {
      display flex
      align-items flex-start
      min-height var(--picx-control-height)
      height auto
      margin-right 0
      padding 8px 0
      white-space normal
    }

    :deep(.el-radio__label) {
      min-width 0
      line-height 1.6
      white-space normal
    }

    .desc {
      margin-left 10rem
      color var(--text-color-4)
      font-size var(--picx-font-body)
      overflow-wrap anywhere

      +picx-mobile() {
        display block
        margin-left 0
      }
    }
  }
}
