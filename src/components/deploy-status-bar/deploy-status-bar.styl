.deploy-item {
  display grid
  gap 12px
  min-width 0
  color var(--picx-color-text)
  font-size 14px
  line-height 1.6

  .left-wrap, .deployment-actions {
    display flex
    flex-wrap wrap
    align-items center
    gap 8px
  }

  p {
    margin 0
    overflow-wrap anywhere
  }

  a {
    display inline-flex
    align-items center
    gap 8px
    min-height 44px
    color var(--picx-color-primary)
  }

  .el-button {
    min-height 44px
    height auto
    margin-left 0

    :deep(> span) {
      flex-wrap wrap
      gap 8px
      white-space normal
    }
  }
}
