.deploy-item {
  display grid
  gap 12px
  min-width 0
  color var(--picx-color-text)
  font-size 14px
  line-height 1.6

  .left-wrap, .deployment-actions {
    display flex
    flex-wrap wrap
    align-items center
    gap 8px
  }

  p {
    margin 0
    overflow-wrap anywhere
  }

  a {
    display inline-flex
    align-items center
    gap 8px
    min-height 44px
    color var(--picx-color-primary)
  }

  .el-button {
    min-height 44px
    height auto
    margin-left 0

    :deep(> span) {
      flex-wrap wrap
      gap 8px
      white-space normal
    }
  }
}

.deployment-state {
  display inline-flex
  align-items center
  gap 6px
}

.compact .deploy-item {
  gap 8px
  padding 0
  line-height 1.5

  .left-wrap {
    justify-content space-between

    strong {
      font-weight 500
    }
  }

  .deployment-state {
    color var(--picx-color-text-muted)
  }

  .deployment-actions {
    display grid
  }

  .el-button {
    width 100%
    height 44px
    border-radius 10px
  }

  .el-button--primary.is-plain {
    opacity 1
    --el-button-border-color var(--picx-color-primary-soft)
    --el-button-disabled-text-color var(--picx-color-primary)
    --el-button-disabled-bg-color var(--picx-color-primary-soft)
    --el-button-disabled-border-color var(--picx-color-primary-soft)
  }
}
