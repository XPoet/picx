.header-content-box {
  position relative
  z-index var(--picx-layer-header)
  display flex
  flex-shrink 0
  align-items center
  gap var(--picx-space-6)
  box-sizing border-box
  height var(--picx-header-height)
  margin 24px 32px 0
  padding 12px 24px
  background var(--picx-color-surface)
  border 1px solid var(--picx-color-border)
  border-radius var(--picx-radius-header)
  box-shadow 0 6px 28px var(--picx-color-shadow)

  .brand-box {
    display flex
    flex 0 1 280px
    align-items center
    min-width 0
    min-height var(--picx-control-height)
    border-radius var(--picx-radius-control)
  }

  .product-name {
    color var(--picx-color-text)
    font-weight 600
    font-size 18px
    white-space nowrap
  }

  @media (max-width 1439px) {
    .brand-box {
      flex-basis 128px
    }

    .product-name {
      display none
    }
  }

  @media (max-width 1279px) {
    justify-content space-between
    gap var(--picx-space-3)
    margin 16px 24px 0
  }

  @media (max-width $picx-mobile-breakpoint) {
    margin 16px 16px 0
    padding 12px 16px
  }
}
