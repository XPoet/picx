.header-content-box {
  flex-shrink 0
  height $header-height
  padding 0 $left-side-padding
  user-select none

  .brand-box {
    display flex
    align-items center
    gap 4px
    min-height 44px
    height 100%
    border-radius $box-border-radius

    &:focus-visible {
      outline 2px solid var(--el-color-primary)
      outline-offset 2px
    }
  }

  .logo {
    flex-shrink 0
    width 108px
    height 44px
  }

  .title {
    overflow hidden
    font-weight bold
    font-size 14px
    white-space nowrap
    text-overflow ellipsis
  }

  &.folded {
    padding 0 10px

    .brand-box {
      justify-content center
    }

    .title {
      display none
    }

    .logo {
      width 40px
      height 40px
    }
  }
}
