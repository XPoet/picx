.start-link {
  display inline-flex
  align-items center
  justify-content center
  box-sizing border-box
  min-height var(--picx-control-height)
  padding 8px 20px
  color var(--picx-color-on-primary)
  font-weight 600
  font-size var(--picx-font-body)
  white-space nowrap
  background var(--picx-color-primary)
  border-radius 24px

  &:link {
    color var(--picx-color-on-primary)
  }

  &:hover {
    background var(--picx-color-primary-hover)
  }
}

.avatar {
  display inline-flex
  flex-shrink 0
  align-items center
  justify-content center
  width 32px
  height 32px
  overflow hidden
  color var(--picx-color-primary)
  background var(--picx-color-primary-soft)
  border-radius 50%

  img {
    width 100%
    height 100%
    object-fit cover
  }
}

.account-name {
  max-width 104px
  overflow hidden
  font-size var(--picx-font-body)
  white-space nowrap
  text-overflow ellipsis
}
