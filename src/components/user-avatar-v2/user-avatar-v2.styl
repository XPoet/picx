.start-link {
  color var(--picx-color-text-muted)
  background var(--picx-color-primary-soft)

  &:link {
    color var(--picx-color-text-muted)
  }

  &:hover {
    color var(--picx-color-primary)
  }
}

.avatar {
  display inline-flex
  flex-shrink 0
  align-items center
  justify-content center
  width 32px
  height 32px
  overflow hidden
  color var(--picx-color-primary)
  background var(--picx-color-primary-soft)
  border-radius 50%

  img {
    width 100%
    height 100%
    object-fit cover
  }
}

.account-name {
  max-width 104px
  overflow hidden
  font-size var(--picx-font-body)
  white-space nowrap
  text-overflow ellipsis
}
