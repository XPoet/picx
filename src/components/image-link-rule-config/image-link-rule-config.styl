.link-rule-config {
  .link-rule-list {
    display grid
    gap 16px
    margin 0
    padding 0
    list-style none

    li {
      display grid
      grid-template-columns minmax(100px, 160px) minmax(0, 1fr) auto
      align-items center
      gap 12px
      padding-bottom 16px
      border-bottom 1px solid var(--picx-color-border)
    }
  }

  .link-rule-actions {
    display flex
    flex-wrap wrap
    gap 8px
    justify-content flex-end
  }

  .link-rule-form {
    display grid
    gap 8px
    min-width 0
    margin-top 8px

    h3 {
      margin 0 0 8px
      font-size 16px
    }
  }

  @media (max-width 1023px) {
    .link-rule-list li {
      grid-template-columns minmax(0, 1fr)
    }
  }
}
