.main-container {
  display flex
  flex-direction column
  box-sizing border-box
  width 100%
  min-height 100dvh
  color var(--picx-color-text)
  background var(--picx-color-bg)

  .main-content {
    flex 1
    box-sizing border-box
    min-height 0
    width 100%
    max-width calc(var(--picx-content-max-width) + 64px)
    margin 0 auto
    padding 32px

    :deep(.page-container) {
      border-radius var(--picx-radius-card)
    }
  }

  @media (min-width 768px) and (max-width 1279px) {
    .main-content {
      padding 24px
    }
  }

  @media (max-width $picx-mobile-breakpoint) {
    .main-content {
      padding 24px 16px

      :deep(.page-container) {
        padding 16px
      }
    }
  }
}
