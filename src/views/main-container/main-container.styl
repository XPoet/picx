.main-container {
  display flex
  box-sizing border-box
  width 100%
  height 100%
  height 100dvh
  overflow hidden
  background var(--background-color-2)

  .sidebar {
    display flex
    flex 0 0 $left-side-width
    flex-direction column
    min-height 0
    padding-top 12rem
  }

  .main-content {
    flex 1
    min-width 0
    height 100%
    padding 16rem 16rem 16rem 0
    overflow hidden

    :deep(.page-container) {
      border-radius $box-border-radius
    }
  }

  &.folded .sidebar {
    flex-basis 72px
  }

  +picx-mobile() {
    .sidebar {
      flex-basis 200px
    }

    .main-content {
      padding 8px 8px 8px 0

      :deep(.page-container) {
        padding 16px
      }
    }
  }
}
