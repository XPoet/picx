.settings-page-container {
  display grid
  gap 48px
  padding 8px 0 32px
  color var(--picx-color-text)
  font-size 14px
  line-height 1.6

  .settings-section {
    display grid
    gap 20px
    min-width 0
  }

  .settings-section-heading {
    h1 {
      margin 0 0 4px
      font-size 22px
      line-height 1.4
    }

    p {
      margin 0
    }
  }

  p {
    color var(--picx-color-text-muted)
    overflow-wrap anywhere
  }

  .settings-grid {
    display grid
    grid-template-columns repeat(2, minmax(0, 1fr))
    gap 24px
    align-items stretch
  }

  .settings-card {
    display flex
    flex-direction column
    gap 16px
    min-width 0
    padding 28px
    background var(--picx-color-surface)
    border-radius var(--picx-radius-card)

    h2 {
      margin 0
      font-size 17px
      line-height 1.5
    }

    p {
      margin 0
    }
  }

  .settings-switch-row {
    display flex
    flex-direction row
    align-items center
    justify-content space-between
    gap 20px
    min-height 44px

    > div:first-child {
      min-width 0
    }

    .el-switch {
      flex-shrink 0
    }
  }

  .settings-preview {
    display block
    min-width 0
    padding 12px 16px
    color var(--picx-color-text)
    background var(--picx-color-surface-muted)
    border-radius var(--picx-radius-control)
    font-size 14px
    overflow-wrap anywhere
    white-space pre-wrap
  }

  .settings-domain-row {
    display flex
    gap 8px

    .el-input {
      flex 1
      min-width 0
    }
  }

  .el-button {
    min-width 44px
    min-height 44px
    height auto
    margin-left 0

    > span {
      flex-wrap wrap
      gap 8px
      white-space normal
    }
  }

  .el-select {
    width 100%
    min-width 0
  }

  .el-form-item {
    min-width 0
  }

  .el-form-item__content {
    min-width 0
  }

  .el-radio-group {
    display flex
    flex-wrap wrap
    gap 8px
  }

  .el-radio {
    min-height 44px
    height auto
    margin-right 12px
    white-space normal
  }

  .el-table {
    overflow-x auto
  }

  .deploy-item {
    flex-wrap wrap
    height auto
    min-height 44px
    gap 12px

    .left-wrap {
      flex-wrap wrap
      gap 8px
    }
  }

  @media (max-width 767px) {
    gap 32px

    .settings-grid {
      grid-template-columns minmax(0, 1fr)
      gap 16px
    }

    .settings-card {
      padding 20px 16px
    }

    .settings-domain-row {
      flex-direction column
    }

    input, textarea, select {
      font-size 16px
    }

    .el-form-item {
      flex-direction column
      align-items stretch
    }

    .el-form-item__label {
      justify-content flex-start
      width auto !important
      height auto
      min-height 28px
      line-height 1.6
    }

    .el-form-item__content {
      margin-left 0 !important
    }
  }
}
