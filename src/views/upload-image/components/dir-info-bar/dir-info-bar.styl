.dir-info-bar {
  display flex
  flex-wrap wrap
  align-items center
  justify-content flex-start

  .dir-name {
    display flex
    align-items center
    justify-content flex-start
    margin-right 6rem
    min-width 0
    overflow-wrap anywhere
    cursor pointer

    .el-icon {
      margin-right 4rem
      font-size 16rem
    }
  }
}
