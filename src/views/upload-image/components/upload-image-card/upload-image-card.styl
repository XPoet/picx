.upload-image-card-container {
  box-sizing border-box
  min-width 0
  padding 12px 0
  color var(--picx-color-text)
  border-bottom 1px solid var(--picx-color-border)
  font-size 14px

  .queue-media-line {
    display flex
    align-items center
    gap 10px
    min-width 0
  }

  .media-thumbnail {
    position relative
    flex-shrink 0
    width 48px
    height 48px
    padding 0
    overflow hidden
    background var(--picx-color-surface-muted)
    border 0
    border-radius 8px
    cursor pointer

    img
    video {
      display block
      width 100%
      height 100%
      object-fit cover
    }

    .video-label {
      position absolute
      inset auto 0 0
      color var(--picx-color-on-primary)
      background var(--picx-color-primary)
      font-size 12px
      line-height 18px
    }
  }

  .queue-file-info {
    flex 1
    min-width 0
  }

  .queue-filename {
    display block
    overflow hidden
    font-weight 600
    line-height 1.5
    text-overflow ellipsis
    white-space nowrap
  }

  .queue-file-size
  .queue-status {
    display flex
    flex-wrap wrap
    align-items center
    gap 4px
    margin-top 4px
    font-size 14px
    color var(--picx-color-text-muted)
    line-height 1.5
  }

  &.uploaded .queue-status {
    color var(--picx-color-success)
  }

  &.failed .queue-status {
    color var(--picx-color-danger)
  }

  .queue-note {
    margin 8px 0
    color var(--picx-color-text-muted)
    line-height 1.6
  }

  .queue-actions {
    display flex
    justify-content flex-end
    margin-top 4px

    button {
      display grid
      place-items center
      width 44px
      height 44px
      padding 0
      color var(--picx-color-primary)
      background transparent
      border 0
      border-radius 8px
      cursor pointer

      &:hover {
        background var(--picx-color-primary-soft)
      }

      &:disabled {
        color var(--picx-color-text-muted)
        cursor not-allowed
      }
    }
  }
}
