.upload-image-card-container {
  box-sizing border-box
  min-width 0
  min-height 78px
  padding 8px
  border 1px solid transparent
  border-radius 10px
  color var(--picx-color-text)
  font-size 14px

  .queue-media-line {
    display grid
    grid-template-columns 48px minmax(0, 1fr) 28px
    align-items center
    gap 8px
    min-width 0
  }

  .media-thumbnail {
    position relative
    flex-shrink 0
    width 48px
    height 48px
    padding 0
    overflow hidden
    background var(--picx-color-surface-muted)
    border 0
    border-radius 6px
    cursor pointer

    &:disabled {
      cursor not-allowed
    }

    img
    video {
      display block
      width 100%
      height 100%
      object-fit cover
    }

    .video-label {
      position absolute
      inset auto 0 0
      color var(--picx-color-on-primary)
      background var(--picx-color-primary)
      font-size 12px
      line-height 18px
    }

  }

  .queue-file-info {
    flex 1
    min-width 0
  }

  .queue-filename {
    display block
    overflow hidden
    font-weight 500
    line-height 1.5
    text-overflow ellipsis
    white-space nowrap
  }

  .queue-file-size
  .queue-status {
    display flex
    flex-wrap wrap
    align-items center
    gap 6px
    margin-top 2px
    font-size 12px
    color var(--picx-color-text-muted)
    line-height 1.5
  }

  .queue-file-size strong {
    color var(--picx-color-text)
    font-weight 600
  }

  &.failed .queue-status {
    color var(--picx-color-danger)
  }

  &.uploading .queue-status {
    color var(--picx-color-primary)
  }

  .queue-note {
    margin 8px 0
    color var(--picx-color-text-muted)
    line-height 1.6
  }

  .queue-actions {
    display flex
    flex-shrink 0
    justify-content flex-end

    .el-button {
      display grid
      place-items center
      min-width 28px
      min-height 28px
      width 28px
      height 28px
      margin 0
      padding 0
      color var(--picx-color-text-muted)
      background transparent
      border 0
      border-radius 6px
      cursor pointer

      &:hover {
        color var(--picx-color-primary)
        background var(--picx-color-primary-soft)
      }

      &.queue-remove:hover {
        color var(--picx-color-danger)
        background var(--picx-color-danger-soft)
      }

      &:disabled {
        color var(--picx-color-text-muted)
        cursor not-allowed
      }
    }
  }
}
