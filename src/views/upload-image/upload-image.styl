.upload-page-container {
  display grid
  grid-template-columns minmax(0, 1fr) 320px
  align-items start
  gap 24px
  min-width 0
  width 100%

  .upload-page-main {
    min-width 0
  }

  .upload-stage {
    display grid
    min-width 0
    min-height 600px
    background var(--picx-color-surface)
    border-radius var(--picx-radius-control)

    &.has-queue {
      grid-template-columns 220px minmax(0, 1fr)
      border 1px solid var(--picx-color-border)

      > .getting-images-container {
        border 0
        border-radius 0 var(--picx-radius-control) var(--picx-radius-control) 0
      }
    }
  }

  .upload-page-left {
    box-sizing border-box
    min-width 0
    max-height 660px
    padding 16px
    overflow-y auto
    border-right 1px solid var(--picx-color-border)

    .uploaded-item + .uploaded-item {
      margin-top 12px
    }
  }

  @media (max-width 1279px) {
    grid-template-columns minmax(0, 1fr)

    .upload-stage {
      min-height 480px
    }
  }

  @media (max-width 767px) {
    gap 16px

    .upload-stage.has-queue {
      grid-template-columns minmax(0, 1fr)

      > .getting-images-container {
        order -1
        border-bottom 1px solid var(--picx-color-border)
        border-radius var(--picx-radius-control) var(--picx-radius-control) 0 0
      }
    }

    .upload-page-left {
      max-height 460px
      border-right 0
    }
  }
}
