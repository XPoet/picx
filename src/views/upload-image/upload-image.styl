.upload-page-container {
  display flex
  align-items flex-start
  gap var(--picx-space-4)
  justify-content space-between
  width 100%
  height auto
  min-width 0

  .upload-page-left {
    flex-shrink 0
    box-sizing border-box
    width 244px
    max-height unquote('min(720px, 70dvh)')
    overflow-y auto

    .uploaded-item {
      width 100%
      margin-bottom 20rem

      &:last-child {
        margin-bottom 0
      }
    }
  }


  .upload-page-right {
    box-sizing border-box
    min-width 0
    width 100%
    height auto

    &.has-left {
      border-radius var(--picx-radius-card)
    }

    .row-item {
      display flex
      justify-content center
      box-sizing border-box
      width 100%
      margin-bottom 16rem

      &:last-child {
        margin-bottom 0
      }

      .content-box {
        box-sizing border-box
        width 100%
        max-width $content-max-width
        margin 0 auto

        &.upload-area-status {
          display flex
          align-items center
          justify-content space-between
          margin-bottom 10rem
          font-size 14rem
        }


        &.operation-btn {
          display flex
          justify-content flex-end
        }


        .shortcut-key {
          margin-left 5rem
          padding 4rem 5rem
          font-size 12rem
          letter-spacing 1rem
          border-radius 4rem
          box-shadow 1rem 2rem 3rem var(--shadow-color)

          +picx-tablet() {
            display none
          }
        }
      }
    }

    .upload-tools {
      width 100%

      .repos-dir-info {
        margin-bottom 20rem
        font-size 12rem

        .repos-dir-info-item {
          margin-right 10rem

          &:last-child {
            margin-right 0
          }
        }
      }
    }
  }

  @media (max-width $picx-mobile-breakpoint) {
    flex-direction column

    .upload-page-left {
      width 100%
      max-height 50dvh
    }

    .upload-page-right .row-item .content-box {
      &.upload-area-status
      &.operation-btn {
        flex-wrap wrap
        gap var(--picx-space-2)
      }
    }
  }
}
