.upload-page-container {
  display grid
  grid-template-columns minmax(0, 1fr) 320px
  align-items start
  gap 24px
  min-width 0
  width 100%

  .upload-page-main {
    min-width 0
  }

  .upload-stage {
    display grid
    min-width 0
    min-height 408px
    background var(--picx-color-surface)
    border-radius 24px

    &.has-queue {
      grid-template-columns 244px minmax(0, 1fr)
      border 1px solid var(--picx-color-border)

      > .upload-intake {
        border 0
        border-radius 0 24px 24px 0
      }
    }
  }

  .upload-intake {
    display flex
    flex-direction column
    min-width 0

    .getting-images-container {
      flex 1
    }
  }

  .has-queue .upload-intake .getting-images-container {
    border 0
  }

  .upload-stage.has-successes {
    grid-template-columns 352px minmax(0, 1fr)
  }

  .workspace-notice {
    display flex
    flex-wrap wrap
    align-items center
    gap 12px
    margin-bottom 16px
    padding 16px
    color var(--picx-color-text)
    background var(--picx-color-primary-soft)
    border-radius var(--picx-radius-control)
    font-size 14px
    line-height 1.6
  }

  .retained-note {
    margin 0
    padding 16px 24px
    color var(--picx-color-text-muted)
    font-size 14px
    line-height 1.6
  }

  .upload-page-left {
    box-sizing border-box
    min-width 0
    max-height 660px
    padding 16px
    overflow-y auto
    border-right 1px solid var(--picx-color-border)

    .queue-heading {
      display flex
      align-items center
      justify-content space-between
      gap 8px
      min-height 44px
      font-size 14px

      h2 {
        margin 0
        font-size 16px
      }
    }

    .queue-add {
      width 100%
      margin-top 12px

      > span {
        gap 8px
      }
    }
  }

  @media (max-width 1279px) {
    grid-template-columns minmax(0, 1fr)

    .upload-stage {
      min-height 408px
    }

    .upload-stage.has-successes {
      grid-template-columns 260px minmax(0, 1fr)
    }
  }

  @media (max-width 767px) {
    gap 16px

    .upload-stage.has-queue
    .upload-stage.has-successes {
      grid-template-columns minmax(0, 1fr)

      > .upload-intake {
        order -1
        border-bottom 1px solid var(--picx-color-border)
        border-radius var(--picx-radius-control) var(--picx-radius-control) 0 0
      }
    }

    .upload-page-left {
      max-height 460px
      border-right 0
    }
  }
}
