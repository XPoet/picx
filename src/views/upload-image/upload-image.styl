.upload-page-container {
  display grid
  grid-template-columns minmax(0, 1fr) 320px
  align-items start
  gap 24px
  min-width 0
  width 100%

  .upload-page-main {
    min-width 0
  }

  .upload-stage {
    display grid
    min-width 0
    min-height 408px
    background var(--picx-color-surface)
    border-radius 24px

    &.has-queue {
      grid-template-columns 280px minmax(0, 1fr)
      gap 16px
      height 704px
      background transparent
    }
  }

  .upload-intake {
    display flex
    flex-direction column
    min-width 0

    .getting-images-container {
      flex 1
    }
  }

  .has-queue .upload-intake .getting-images-container {
    min-height 0
  }

  .workspace-notice {
    display flex
    flex-wrap wrap
    align-items center
    gap 12px
    margin-bottom 16px
    padding 16px
    color var(--picx-color-text)
    background var(--picx-color-primary-soft)
    border-radius var(--picx-radius-control)
    font-size 14px
    line-height 1.6
  }

  .upload-page-left {
    display flex
    flex-direction column
    box-sizing border-box
    min-width 0
    min-height 0
    gap 8px
    padding 12px
    background var(--picx-color-surface)
    border 1px solid var(--picx-color-border)
    border-radius 16px

    .queue-heading {
      display flex
      flex-shrink 0
      align-items center
      justify-content space-between
      gap 8px
      height 44px
      padding 0 4px
      color var(--picx-color-text-muted)
      font-size 14px
      line-height 1.5

      h2 {
        margin 0
        color var(--picx-color-text)
        font-size 14px
        font-weight 600
      }
    }

    .queue-scrollbar {
      flex 1
      min-height 0
    }

    .queue-list {
      display flex
      flex-direction column
      gap 4px
    }

    .queue-add {
      flex-shrink 0
      width 100%
      height 44px
      color var(--picx-color-primary)
      border-radius 10px

      > span {
        gap 8px
      }
    }
  }

  @media (max-width 1279px) {
    grid-template-columns minmax(0, 1fr)
  }

  @media (max-width 767px) {
    gap 16px

    .upload-stage.has-queue {
      grid-template-columns minmax(0, 1fr)
      height auto
    }

    .upload-page-left {
      height 460px
    }

    .has-queue .upload-intake {
      order -1

      .getting-images-container {
        min-height 340px
      }
    }
  }
}

@media (min-width 1280px) {
  .main-container .main-content:has(.upload-page-container) {
    padding-top 16px
  }
}
