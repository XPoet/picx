.tools-bar {
  display flex
  align-items center
  justify-content space-between
  width 100%
  height 100%

  .left {
    .dir-info {
      margin-left 2rem

      .el-icon {
        margin-right 4rem
        color var(--text-color-3)
        font-size 16rem
      }
    }
  }


  .right {
    .el-icon {
      margin-left 10rem
      color var(--text-color-3)
      font-size 22rem
      cursor pointer
    }

    .sort-dropdown {
      cursor pointer

      // 命中区域扩大到 44×44px，负外边距补偿使图标视觉位置与相邻图标一致
      .el-icon {
        margin 0 -1rem 0 -11rem
        padding 11rem
      }

      .btn-icon.is-active {
        color var(--el-color-primary)
      }
    }
  }
}
