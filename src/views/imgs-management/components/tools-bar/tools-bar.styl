.tools-bar {
  box-sizing border-box
  display flex
  align-items center
  gap 8px
  width 100%
  min-width 0
  padding 8px 12px
  border 1px solid var(--picx-color-border)
  border-radius var(--picx-radius-control)
  background var(--picx-color-surface)
  font-size 14px

  button {
    display inline-flex
    flex-shrink 0
    align-items center
    justify-content center
    min-width 44px
    min-height 44px
    padding 8px
    border 0
    border-radius 8px
    background transparent
    color var(--picx-color-text-muted)
    font inherit
    cursor pointer

    &:hover:not(:disabled) {
      background var(--picx-color-primary-soft)
      color var(--picx-color-primary)
    }

    &:disabled {
      opacity 0.45
      cursor default
    }
  }

  .directory-breadcrumbs {
    display flex
    flex 1
    align-items center
    gap 4px
    min-width 0
    overflow-x auto
    color var(--picx-color-primary)

    ol, li {
      display flex
      align-items center
      margin 0
      padding 0
      list-style none
    }

    button {
      max-width 280px
      overflow hidden
      text-overflow ellipsis
      white-space nowrap
    }

    [aria-current='page'] {
      color var(--picx-color-text)
    }
  }

  .directory-tools {
    display flex
    align-items center
    gap 8px
  }

  .directory-upload {
    gap 8px
    border 1px solid var(--picx-color-border)
  }

  @media (max-width 767px) {
    flex-wrap wrap

    .directory-breadcrumbs {
      flex-basis calc(100% - 60px)
    }

    .directory-tools {
      justify-content flex-end
      width 100%
    }
  }
}
