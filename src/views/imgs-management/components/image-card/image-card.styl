.image-card {
  position relative
  overflow hidden
  min-width 0
  border 1px solid var(--picx-color-border)
  border-radius 12px
  background var(--picx-color-surface)

  &.checked {
    border-color var(--picx-color-primary)
    box-shadow 0 0 0 1px var(--picx-color-primary)
  }

  button {
    font inherit
    cursor pointer

    &:disabled {
      cursor default
    }
  }

  .media-thumbnail {
    position relative
    aspect-ratio 1.65
    background var(--picx-color-surface-muted)
  }

  .image-preview {
    display block
    position relative
    width 100%
    height 100%
    min-height 120px
    padding 0
    border 0
    background transparent

    img, video {
      width 100%
      height 100%
      object-fit cover
    }

    .play-icon {
      position absolute
      top 50%
      left 50%
      padding 12px
      border-radius 50%
      background var(--picx-color-surface)
      color var(--picx-color-primary)
      transform translate(-50%, -50%)
    }
  }

  .media-select {
    display flex
    position absolute
    z-index 1
    top 0
    left 0
    align-items center
    justify-content center
    width 44px
    height 44px
    cursor pointer

    input {
      position absolute
      width 44px
      height 44px
      margin 0
      opacity 0
      cursor pointer

      &:focus-visible + span {
        outline 2px solid var(--picx-color-focus)
        outline-offset 3px
      }
    }

    span {
      display flex
      align-items center
      justify-content center
      width 20px
      height 20px
      border 1px solid var(--picx-color-control-border)
      border-radius 5px
      background var(--picx-color-surface)
      color var(--picx-color-on-primary)
      pointer-events none
    }

    input:checked + span {
      border-color var(--picx-color-primary)
      background var(--picx-color-primary)
    }
  }

  .media-error {
    display flex
    position absolute
    inset 0
    flex-direction column
    align-items center
    justify-content center
    gap 8px
    padding 16px 24px
    background var(--picx-color-surface-muted)
    color var(--picx-color-text-muted)
    font-size 14px
    text-align center

    button {
      min-height 44px
      padding 8px 12px
      border 1px solid var(--picx-color-control-border)
      border-radius 8px
      background var(--picx-color-surface)
      color var(--picx-color-text)
    }
  }

  .media-details {
    padding 8px 12px 0
  }

  .media-filename {
    display block
    width 100%
    min-height 44px
    padding 0
    overflow hidden
    border 0
    background transparent
    color var(--picx-color-text)
    font-size 14px
    text-align left
    text-overflow ellipsis
    white-space nowrap
  }

  .media-metadata {
    display flex
    flex-wrap wrap
    gap 4px 12px
    min-height 20px
    margin 0 0 8px
    color var(--picx-color-text-muted)
    font-size 14px
  }

  .media-actions {
    display flex
    align-items center
    justify-content space-between
    padding 0 4px
    border-top 1px solid var(--picx-color-border)

    button {
      display inline-flex
      align-items center
      justify-content center
      gap 6px
      min-width 44px
      min-height 44px
      padding 8px
      border 0
      border-radius 8px
      background transparent
      color var(--picx-color-primary)
      font-size 14px

      &:hover {
        background var(--picx-color-primary-soft)
      }
    }
  }

  .video-preview {
    display block
    width 100%
    max-height 65vh
  }
}
