.folder-card {
  min-width 0
  height 100%
  border-radius var(--picx-radius-control)

  &.active, &:hover {
    background var(--picx-color-primary-soft)
  }

  button {
    display flex
    flex-direction column
    align-items center
    gap 8px
    width 100%
    min-height 132px
    padding 16px 8px
    border 0
    border-radius inherit
    background transparent
    color var(--picx-color-primary)
    font inherit
    cursor pointer
  }

  .folder-name {
    display -webkit-box
    max-width 100%
    overflow hidden
    color var(--picx-color-text)
    font-size 14px
    overflow-wrap anywhere
    -webkit-box-orient vertical
    -webkit-line-clamp 2
  }

  .folder-kind {
    color var(--picx-color-text-muted)
    font-size 14px
  }
}
