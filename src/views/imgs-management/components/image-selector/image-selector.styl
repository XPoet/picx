.selector-wrapper {
  display flex
  flex 1
  flex-wrap wrap
  align-items center
  gap 4px 12px
  min-width 0
  padding 4px 8px
  border-radius 10px
  font-size 14px

  &.has-selection {
    background var(--picx-color-primary-soft)
  }

  .select-all {
    display inline-flex
    align-items center
    gap 8px
    min-height 44px
    cursor pointer

    input {
      width 20px
      height 20px
      margin 0
      accent-color var(--picx-color-primary)
    }

    span {
      line-height 1.5
    }
  }

  button {
    display inline-flex
    align-items center
    justify-content center
    gap 6px
    min-width 44px
    min-height 44px
    padding 8px
    border 0
    border-radius 8px
    background transparent
    color var(--picx-color-primary)
    font inherit
    cursor pointer

    &:hover {
      background var(--picx-color-surface)
    }

    &:disabled {
      cursor default
      opacity 0.6
    }
  }

  .batch-delete {
    color var(--picx-color-danger)
  }

  @media (max-width 767px) {
    flex-basis 100%
  }
}
