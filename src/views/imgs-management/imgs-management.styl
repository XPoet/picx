.management-page-container {
  display flex
  flex-direction column
  gap 16px
  min-width 0
  padding-top 0 !important
  padding-bottom 24px !important
  font-size 14px

  .management-summary {
    display flex
    align-items center
    justify-content space-between
    gap 16px
    min-height 48px

    .el-select {
      width 180px
    }
  }

  .management-content {
    min-height 480px
    padding 24px
    border 1px solid var(--picx-color-border)
    border-radius 14px
    background var(--picx-color-surface)
  }

  ul {
    margin 0
    padding 0
    list-style none
  }

  .dir-card-list {
    display grid
    grid-template-columns repeat(auto-fill, minmax(120px, 140px))
    gap 16px
    margin-bottom 24px
  }

  .image-card-list {
    display grid
    grid-template-columns repeat(4, minmax(0, 1fr))
    gap 20px

    > li {
      min-width 0
      min-height 240px
    }
  }

  .management-error {
    display flex
    align-items center
    gap 12px
    padding 12px
    border-radius var(--picx-radius-control)
    background var(--picx-color-danger-soft)
    color var(--picx-color-danger)

    span {
      flex 1
    }
  }

  @media (max-width 1023px) {
    .image-card-list {
      grid-template-columns repeat(3, minmax(0, 1fr))
    }
  }

  @media (max-width 767px) {
    .management-content {
      padding 16px
    }

    .image-card-list {
      grid-template-columns repeat(2, minmax(0, 1fr))
      gap 16px
    }

    .management-error {
      flex-wrap wrap
    }
  }

  @media (max-width 479px) {
    .image-card-list {
      grid-template-columns minmax(0, 1fr)
    }
  }
}
