.management-page-container {
  display flex
  flex-direction column
  gap 16px
  min-width 0
  padding 0 !important
  background transparent
  font-size 14px

  .management-summary {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap 16px
    min-height 48px

    h1 {
      flex 1
      margin 0
      font-size 16px
      font-weight 600
    }

    .grid-indicator {
      display inline-flex
      align-items center
      justify-content center
      width 44px
      height 44px
      border-radius 8px
      background var(--picx-color-primary-soft)
      color var(--picx-color-primary)
      order 1
    }

    .el-select {
      width 180px
    }
  }

  .management-content {
    min-height 480px
    padding 24px
    border 1px solid var(--picx-color-border)
    border-radius 14px
    background var(--picx-color-surface)
  }

  .media-section-heading {
    display flex
    flex-wrap wrap
    align-items center
    justify-content space-between
    gap 8px 16px
    margin-bottom 16px

    h2 {
      margin-bottom 0
    }

    :deep(.selector-wrapper) {
      flex 0 1 auto
    }
  }

  h2 {
    display flex
    align-items center
    gap 8px
    margin 0 0 16px
    font-size 14px
    font-weight 600

    span {
      color var(--picx-color-text-muted)
      font-weight 400
    }
  }

  .management-search {
    display flex
    align-items center
    gap 8px
    box-sizing border-box
    min-width 0
    width 280px
    min-height 44px
    padding 0 12px
    border 1px solid var(--picx-color-border)
    border-radius 8px
    color var(--picx-color-text-muted)

    input {
      min-width 0
      width 100%
      height 42px
      border 0
      background transparent
      color var(--picx-color-text)
      font-size 14px
    }
  }

  .management-empty {
    display flex
    flex-direction column
    align-items center
    gap 16px
    padding 80px 16px
    text-align center
    color var(--picx-color-text-muted)

    h2, p {
      margin 0
      line-height 1.6
    }

    h2 {
      color var(--picx-color-text)
      font-size 18px
    }

    .el-button :deep(> span) {
      gap 8px
    }
  }

  ul {
    margin 0
    padding 0
    list-style none
  }

  .dir-card-list {
    display grid
    grid-template-columns repeat(auto-fill, minmax(120px, 140px))
    gap 16px
    margin-bottom 24px
  }

  .image-card-list {
    display grid
    grid-template-columns repeat(4, minmax(0, 1fr))
    gap 20px

    > li {
      min-width 0
      min-height 240px
    }
  }

  .management-error {
    display flex
    align-items center
    gap 12px
    padding 12px
    border-radius var(--picx-radius-control)
    background var(--picx-color-danger-soft)
    color var(--picx-color-danger)

    span {
      flex 1
    }
  }

  @media (max-width 1023px) {
    .image-card-list {
      grid-template-columns repeat(3, minmax(0, 1fr))
    }
  }

  @media (max-width 767px) {
    .management-content {
      padding 16px
    }

    .management-search {
      flex 1 0 calc(100% - 60px)
      width auto

      input {
        font-size 16px
      }
    }

    :deep(.directory-tools) {
      flex-wrap wrap
    }

    .image-card-list {
      grid-template-columns repeat(2, minmax(0, 1fr))
      gap 16px
    }

    .management-error {
      flex-wrap wrap
    }
  }

  @media (max-width 479px) {
    .image-card-list {
      grid-template-columns minmax(0, 1fr)
    }
  }
}
